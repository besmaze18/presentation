# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit the real .env file.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# ------------------------------ PostgreSQL ---------------------------------
POSTGRES_DB=fittrack
POSTGRES_USER=fittrack
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_PORT=5432

# --------------------------- Backend / general ------------------------------
SERVER_PORT=8080
LOG_LEVEL=INFO
SPRING_PROFILES_ACTIVE=

# Origins allowed to call the API from a browser (comma separated).
APP_CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:8081

# Set to false once your account exists to close public sign-up.
REGISTRATION_ENABLED=true

# ------------------------------ Security ------------------------------------
# REQUIRED. At least 32 bytes. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Set to true when the API is served over HTTPS.
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAME_SITE=Lax

# REQUIRED. 32-byte key used to encrypt third-party OAuth tokens at rest.
# Generate one with:  openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# ------------------------------- AI provider --------------------------------
# Multimodal LLM used for food-photo and natural-language analysis.
# Provider-independent: see backend/src/main/java/com/fittrack/ai/service/FoodAnalysisService.java
AI_PROVIDER=anthropic
AI_ENABLED=true
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MAX_TOKENS=4096
AI_TIMEOUT=60s

# ------------------------------ File storage --------------------------------
# `local` writes to disk (fine for development); `cloudjs` uses the Cloud.js
# object-storage adapter. See docs/ARCHITECTURE.md -> "Cloud.js storage".
STORAGE_PROVIDER=local
STORAGE_MAX_FILE_SIZE_BYTES=10485760
STORAGE_SIGNED_URL_TTL=15m
STORAGE_LOCAL_DIR=/var/lib/fittrack/uploads
STORAGE_LOCAL_PUBLIC_BASE_URL=http://localhost:8080/api/storage/files
MAX_UPLOAD_SIZE=10MB

CLOUDJS_CLOUD_NAME=
CLOUDJS_API_KEY=
CLOUDJS_API_SECRET=
CLOUDJS_BASE_URL=https://api.cloudinary.com/v1_1
CLOUDJS_DELIVERY_BASE_URL=https://res.cloudinary.com
CLOUDJS_FOLDER=fittrack/meals
# When true, uploads are stored as `authenticated` assets reachable only via signed URLs.
CLOUDJS_PRIVATE=true

# --------------------------------- WHOOP ------------------------------------
# Register an app at https://developer.whoop.com and add the redirect URI below.
WHOOP_ENABLED=true
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:8080/api/whoop/callback
# Where the browser lands after the OAuth dance completes.
WHOOP_APP_REDIRECT_URI=http://localhost:5173/settings
WHOOP_API_BASE_URL=https://api.prod.whoop.com/developer
WHOOP_AUTHORIZE_URL=https://api.prod.whoop.com/oauth/oauth2/auth
WHOOP_TOKEN_URL=https://api.prod.whoop.com/oauth/oauth2/token
WHOOP_INITIAL_SYNC_DAYS=90
WHOOP_SYNC_CRON=0 0 * * * *

# -------------------------------- Frontend ----------------------------------
FRONTEND_PORT=8081
# Base URL the browser uses to reach the API. Leave empty to use same-origin /api
# (the default when running behind the bundled nginx or the Vite dev proxy).
VITE_API_PROXY_TARGET=http://localhost:8080

# ------------------------------- Dev seed data ------------------------------
# When true the backend creates a demo user with sample data on startup.
SEED_ENABLED=false
SEED_EMAIL=demo@fittrack.local
SEED_PASSWORD=
SEED_DAYS=30
